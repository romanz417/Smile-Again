---
import '../styles/global.css';
import { contact, socials } from '../lib/site';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Smile Again Families Foundation walks with abused and abandoned teenage mothers in Masaka, Uganda, restoring them emotionally, spiritually and economically.',
} = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/images/hero.webp', Astro.site)} />
    <link rel="icon" href="/images/logo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Source+Sans+3:wght@400;600;700&display=swap" />
  </head>
  <body>
    <div class="topbar">
      <div class="wrap">
        <div class="topbar__group">
          <a href={contact.phoneHref}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{contact.phone}</a>
          <a href={`mailto:${contact.email}`}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>{contact.email}</a>
        </div>
        <span class="topbar__addr"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>{contact.address}</span>
      </div>
    </div>

    <header class="header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="brand__mark"><img src="/images/logo.webp" alt="" width="44" height="49" /></span>
          <span class="brand__name">Smile Again<small>Families Foundation</small></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/#about">About</a>
          <a href="/#projects">Our work</a>
          <a href="/#safe-home">Safe Home</a>
          <a href="/#news">Stories</a>
          <a href="/get-involved">Get involved</a>
          <a class="btn btn--primary" href="/give">Donate</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <div class="wrap grid">
        <div>
          <a class="brand" href="/" style="color:#fff">
            <span class="brand__mark"><img src="/images/logo.webp" alt="" width="44" height="49" /></span>
            <span class="brand__name" style="font-size:20px">Smile Again Families</span>
          </a>
          <p>Restoring hope to teenage mothers in Uganda since 2014.</p>
        </div>
        <div>
          <h3>Explore</h3>
          <div class="footer__links">
            <a href="/#about">Our story</a>
            <a href="/#projects">Projects</a>
            <a href="/#news">Stories</a>
            <a href="/get-involved">Volunteer &amp; sponsor</a>
          </div>
        </div>
        <div>
          <h3>Get in touch</h3>
          <div class="footer__links">
            <a href={contact.phoneHref}>{contact.phone}</a>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
            <span>Kajansembe Drive, Masaka</span>
          </div>
        </div>
        <div>
          <h3>Follow</h3>
          <div class="footer__links">
            {socials.map((s) => <a href={s.href} rel="noopener">{s.label}</a>)}
          </div>
        </div>
      </div>
      <div class="wrap footer__base">© {year} Smile Again Families Foundation · [REGISTRATION / NGO NUMBER]</div>
    </footer>
  </body>
</html>
