---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/public-sans/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { org } from '../data/site';
import { getImage } from 'astro:assets';
import { photo, hasPhoto } from '../lib/photos';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, image = 'proj-girlchild', type = 'website', jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title.includes('Smile Again') ? title : `${title} | Smile Again Families`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: photo(hasPhoto(image) ? image : 'proj-girlchild'), width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const ogUrl = new URL(og.src, Astro.site).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  '@id': new URL('/#organization', Astro.site).href,
  name: org.name,
  alternateName: [org.short, 'Smile Again Families Uganda'],
  url: new URL('/', Astro.site).href,
  logo: new URL('/favicon.png', Astro.site).href,
  foundingDate: String(org.founded),
  email: org.email,
  telephone: org.phone,
  description: 'Smile Again Families Foundation restores abused and abandoned teenage mothers in Masaka, Uganda — emotionally, spiritually and economically.',
  address: { '@type': 'PostalAddress', streetAddress: org.street, addressLocality: org.city, addressCountry: 'UG' },
  areaServed: { '@type': 'Place', name: 'Masaka, Uganda' },
  sameAs: org.socials.map((s) => s.href),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#123D2C" />
    <meta property="og:site_name" content={org.short} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify([orgLd, ...jsonLd])} />
  </head>
  <body>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
