---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="band band--sage">
    <div class="wrap wrap--narrow stack">
      <h1 class="h1">We couldn’t find that page.</h1>
      <p class="lead">It may have moved when we rebuilt our website. Try one of these instead:</p>
      <div class="btns">
        <a class="btn btn--solid" href="/">Go to the home page</a>
        <a class="btn btn--line" href="/our-work">See our programs</a>
        <a class="btn btn--give" href="/give">Donate</a>
      </div>
    </div>
  </section>
</Base>
