---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import StoryCard from '../components/StoryCard.astro';
import { org, impact, ugandaFact } from '../data/site';
import { programs, model } from '../data/programs';
import { students } from '../data/people';
import { getStories } from '../lib/supabase';

const stories = (await getStories()).slice(0, 3);
const safeHome = programs[0];
const featured = ['Mourine', 'Florence', 'Sylvia'].map((n) => students.find((s) => s.name === n)!);
const tiers = [
  { amount: '$45', per: '/month', text: 'Supports a girl’s return to school' },
  { amount: '$50', per: '/month', text: 'Provides essential care and counseling' },
  { amount: '$100', per: '/month', text: 'Funds livelihood and skills training for a young mother', featured: true },
  { amount: '$500', per: '/year', text: 'Helps sustain a mother in the Safe Home' },
  { amount: '$1,000+', per: '', text: 'Transforms many lives across our programs' },
];
const levels = [
  { name: 'Emotionally', warm: false, icon: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8z"/>', text: 'One-on-one counseling, psychosocial support and solidarity groups, so no mother carries her story alone.' },
  { name: 'Spiritually', warm: true, icon: '<path d="M12 2v6M9 5h6"/><path d="M12 8c-4 3-6 6-6 9a6 6 0 0 0 12 0c0-3-2-6-6-9z"/>', text: 'Faith-rooted formation with our partner parishes, helping each mother see the value of her life again.' },
  { name: 'Economically', warm: false, icon: '<path d="M3 21h18M5 21V10l7-5 7 5v11"/><path d="M10 21v-6h4v6"/>', text: 'Vocational and business training — tailoring, hairdressing, computer skills — for income that lasts.' },
];
const heroSlides = [
  { name: 'hero-big', alt: 'Three young children smiling outside a church in Masaka', caption: 'Healing hearts, building futures, one family at a time', pos: '50% 50%' },
  { name: 'hero-summit', alt: 'Mentors praying over a young mother at the Your Worth Summit', caption: 'Empowering families through spiritual and emotional support', pos: '45% 40%' },
  { name: 'hero-sewing', alt: 'A mother at her sewing machine beside her smiling daughter', caption: 'Tackling poverty in communities to build better lives', pos: '35% 50%' },
];
---
<Base
  title="Smile Again Families Foundation | Hope for Teenage Mothers in Uganda"
  description="Smile Again Families restores abused and abandoned teenage mothers in Masaka, Uganda through counseling, education, skills training and a safe home. Give or sponsor a mother today."
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">Masaka, Uganda · Since 2014</p>
        <h1 class="display">Healing hearts, building futures — one family at a time.</h1>
        <p class="lead hero__lead">We walk with abused and abandoned teenage mothers as they rediscover their worth, return to school, learn a skill, and build a stable life for their children.</p>
        <div class="btns">
          <a class="btn btn--give" href="/give">Give monthly</a>
          <a class="btn btn--line" href="/sponsor">Sponsor a mother</a>
        </div>
      </div>
      <div class="hero__media">
        <div class="hero__slides" role="region" aria-roledescription="carousel" aria-label="Life at Smile Again">
          {heroSlides.map((sl, i) => (
            <figure class="hero__slide" data-active={i === 0 ? 'true' : 'false'} aria-hidden={i === 0 ? 'false' : 'true'} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${heroSlides.length}`}>
              <Photo name={sl.name} alt={sl.alt} ratio="free" eager={i === 0} class="hero__img" sizes="(max-width: 860px) 100vw, 50vw" widths={[600, 900, 1200, 1500]} position={sl.pos} />
              <figcaption class="hero__caption">{sl.caption}</figcaption>
            </figure>
          ))}
        </div>
        <div class="hero__badge"><strong>798</strong><span>young mothers’ lives transformed in ten years</span></div>
      </div>
    </div>
  </section>

  <!-- Impact band -->
  <section class="stats" aria-label="Our impact">
    <div class="wrap">
      {impact.map((s) => <div><strong>{s.value}</strong><span>{s.label}</span></div>)}
    </div>
  </section>

  <!-- Who we are -->
  <section class="band">
    <div class="wrap about">
      <div class="about__head">
        <p class="eyebrow">Who we are</p>
        <h2 class="h2">A family that started with one couple’s calling.</h2>
        <Photo name="story-1" alt="Co-founders Fred and Stella" ratio="tall" sizes="(max-width: 860px) 80vw, 360px" widths={[480, 720]} class="about__photo" />
      </div>
      <div class="lead-block">
        <p>In 2014, Fred and Stella — a Catholic couple in Masaka who were helping young adults embrace Christian marriage — kept meeting young women carrying a deep, unhealed wound: early pregnancy, often from rape or defilement, followed by abandonment or an early marriage.</p>
        <p>They set out to find these girls and help them restore hope, through psychosocial support, vocational and business training, a return to school, and a way back into their families and communities.</p>
        <div class="grid-cards" style="--min:240px;gap:20px;margin-top:32px">
          <div class="panel" style="background:var(--sage)">
            <h3>Our mission</h3>
            <p>To support abused and abandoned teenage mothers to discover their inner worth by restoring them emotionally, spiritually and economically.</p>
          </div>
          <div class="panel" style="background:var(--peach)">
            <h3>Our vision</h3>
            <p>Strong, sustainable and reliable families that transform society for generations.</p>
          </div>
        </div>
        <a class="link-more" href="/about" style="margin-top:28px">Read our full story <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- The need -->
  <section class="band band--soft">
    <div class="wrap">
      <div class="need">
        <div>
          <p class="eyebrow">Why it matters</p>
          <h2 class="h2">A pregnancy shouldn’t end a girl’s future.</h2>
        </div>
        <div class="need__stat">
          <strong>{ugandaFact.stat}</strong>
          <p>{ugandaFact.text}</p>
          <p class="small muted">Source: {ugandaFact.source}.</p>
        </div>
      </div>
      <h3 class="h3" style="margin:64px 0 24px">Restoration happens on three levels.</h3>
      <div class="grid-cards" style="--min:260px;gap:24px">
        {levels.map((l) => (
          <div class="card card--pad">
            <span class:list={['icon-tile', { 'icon-tile--warm': l.warm }]}><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={l.icon} /></span>
            <h3 class="h3" style="color:var(--ink)">{l.name}</h3>
            <p>{l.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="band">
    <div class="wrap">
      <div class="row-between" style="margin-bottom:44px">
        <div style="max-width:640px">
          <p class="eyebrow">Our work</p>
          <h2 class="h2">Six programs, one journey back to a full life.</h2>
        </div>
        <a class="link-more" href="/our-work">See all programs <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid-cards">
        {programs.map((p) => (
          <a class="card card-link" href={`/our-work/${p.slug}`}>
            <Photo name={p.cover} alt={p.coverAlt} ratio="free" class="card-img" sizes="(max-width: 860px) 100vw, 33vw" widths={[480, 800]} />
            <div class="card-link__body"><h3>{p.name}</h3><p>{p.summary}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Safe Home -->
  <section class="band band--forest">
    <div class="wrap split">
      <Photo name={safeHome.cover} alt={safeHome.coverAlt} ratio="free" class="safe__img ph--lg" sizes="(max-width: 860px) 100vw, 50vw" />
      <div>
        <p class="pill">Construction complete</p>
        <h2 class="h2">The Guadalupe Mission Home is open. Now help us keep the lights on.</h2>
        <p style="margin:22px 0 0">A safe place for abandoned mothers to live as a family, with daily care before and after birth, a training center for skills workshops, and a children’s day-care and play center.</p>
        <ul class="checks">
          {['Food', 'Medical care', 'School needs', 'Hygiene & childcare'].map((i) => <li><Icon name="check" size={18} />{i}</li>)}
        </ul>
        <div class="btns">
          <a class="btn btn--give" href="/give?for=safe-home">Support Safe Home operations</a>
          <a class="btn btn--line-light" href={`/our-work/${safeHome.slug}`}>Learn more</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Model -->
  <section class="band">
    <div class="wrap">
      <div style="max-width:720px;margin-bottom:44px">
        <p class="eyebrow">Our model</p>
        <h2 class="h2">From crisis to self-reliance in two years.</h2>
      </div>
      <ol class="model">
        {model.map((m, i) => (
          <li class="card card--pad">
            <span class="model__num" aria-hidden="true">{i + 1}</span>
            <h3 class="h3" style="color:var(--ink)">{m.name}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Voice -->
  <section class="band band--soft">
    <div class="wrap voice">
      <Photo name="sp-sylvia" alt="Sylvia holding her daughter" ratio="square" sizes="240px" widths={[420]} position="50% 40%" class="voice__photo" />
      <figure>
        <blockquote>“Thanks to Smile Again, I regained hope. Today I run my own fashion business, making clothes for women and children — and I support other teenage mothers.”</blockquote>
        <figcaption><strong>Sylvia, 20</strong>, mother and fashion entrepreneur</figcaption>
      </figure>
    </div>
  </section>

  <!-- Giving -->
  <section class="band band--peach" id="involved">
    <div class="wrap">
      <div style="text-align:center;max-width:720px;margin:0 auto 48px">
        <p class="eyebrow">Get involved</p>
        <h2 class="h2">Every gift walks with a mother.</h2>
        <p class="lead" style="margin:18px auto 0">General donations cover food, childcare, school materials, counseling and the staff who walk alongside each young woman. US gifts are tax-deductible through our 501(c)(3) partner.</p>
      </div>
      <div class="grid-cards" style="--min:200px;gap:20px">
        {tiers.map((t) => (
          <div class:list={['tier', { 'tier--featured': t.featured }]}>
            {t.featured && <span class="tier__flag">Most impact</span>}
            <strong>{t.amount}{t.per && <small>{t.per}</small>}</strong>
            <p>{t.text}</p>
          </div>
        ))}
      </div>
      <div class="btns" style="justify-content:center;margin-top:40px">
        <a class="btn btn--give" href="/give">Give now</a>
        <a class="btn btn--line" href="/volunteer">Volunteer with us</a>
        <a class="btn btn--line" href="/sponsor">Sponsor a girl’s schooling</a>
      </div>
      <p class="small muted" style="text-align:center;margin-top:24px">US gifts: {org.usEntity}, a 501(c)(3) charity, EIN {org.usEin}</p>
    </div>
  </section>

  <!-- Sponsor -->
  <section class="band">
    <div class="wrap">
      <div class="row-between" style="margin-bottom:44px">
        <div style="max-width:640px">
          <p class="eyebrow">Sponsor a mother</p>
          <h2 class="h2">Send a young mother back to school.</h2>
        </div>
        <a class="link-more" href="/sponsor">Meet all the students <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid-cards" style="--min:260px">
        {featured.map((s) => (
          <a class="card card-link" href={`/sponsor#${s.name.toLowerCase()}`}>
            <Photo name={s.photo} alt={`${s.name}, a young mother hoping to continue her studies`} ratio="free" class="card-img card-img--tall" sizes="(max-width: 860px) 100vw, 33vw" widths={[420, 560]} position="50% 25%" />
            <div class="card-link__body"><h3>{s.name}</h3><p>{s.level}, {s.needPerYear}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section class="band band--soft">
    <div class="wrap">
      <div class="row-between" style="margin-bottom:40px">
        <h2 class="h2">Stories &amp; updates</h2>
        <a class="link-more" href="/stories">All stories <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid-cards" style="--min:290px">
        {stories.map((s) => <StoryCard story={s} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--peach); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 56px; align-items: center; padding-block: 64px 88px; }
  .hero__lead { margin: 24px 0 36px; font-size: 21px; max-width: 560px; }
  .hero__media { position: relative; }
  .hero__slides { position: relative; height: 540px; border-radius: var(--radius-lg); overflow: hidden; background: var(--sage); }
  .hero__slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1s ease; }
  .hero__slide[data-active="true"] { opacity: 1; }
  .hero__slide :global(.hero__img) { height: 100%; border-radius: 0; }
  .hero__caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 64px 28px 24px; color: #fff; font-family: var(--display); font-weight: 700; font-size: 22px; line-height: 1.25; text-align: right; text-wrap: balance; background: linear-gradient(to top, rgba(17, 46, 31, .88), rgba(17, 46, 31, .55) 55%, rgba(17, 46, 31, 0)); }
  .hero__caption { padding-left: 330px; }
  @media (prefers-reduced-motion: reduce) { .hero__slide { transition: none; } }
  .hero__badge { position: absolute; left: -16px; bottom: -28px; z-index: 2; background: #fff; border-radius: 20px; padding: 18px 22px; box-shadow: 0 12px 32px rgba(23,32,27,.14); display: flex; gap: 14px; align-items: center; max-width: 310px; }
  .hero__badge strong { font-family: var(--display); font-weight: 800; font-size: 42px; color: var(--forest); line-height: 1; }
  .hero__badge span { font-size: 15px; line-height: 1.35; color: var(--body); }
  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: minmax(0, 1fr); padding-block: 48px 72px; }
    .hero__slides { height: 400px; }
    .hero__caption { padding: 56px 20px 64px; font-size: 18px; text-align: left; }
    .hero__badge { left: 12px; }
  }

  .stats { background: var(--forest); color: #fff; }
  .stats .wrap { padding-block: 56px; display: grid; gap: 32px; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .stats strong { display: block; font-family: var(--display); font-weight: 800; font-size: 52px; line-height: 1; }
  .stats span { display: block; margin-top: 8px; color: var(--on-dark-muted); font-size: 17px; line-height: 1.4; }
  @media (max-width: 960px) { .stats .wrap { grid-template-columns: repeat(2, minmax(0, 1fr)); } .stats strong { font-size: 42px; } }

  .about { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 56px; }
  .about__head :global(.about__photo) { max-width: 360px; margin-top: 36px; }
  .lead-block { color: var(--body); }
  .lead-block > p { margin-bottom: 20px; }
  @media (max-width: 860px) { .about { grid-template-columns: minmax(0, 1fr); } }

  .need { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .need__stat { background: #fff; border-radius: var(--radius); padding: 32px; border: 1px solid var(--line); }
  .need__stat strong { display: block; font-family: var(--display); font-weight: 800; font-size: clamp(56px, 7vw, 88px); line-height: 1; color: var(--shirt); }
  .need__stat p:not(.small) { font-size: 20px; color: var(--ink); margin: 12px 0; }
  @media (max-width: 860px) { .need { grid-template-columns: minmax(0, 1fr); gap: 32px; } }

  .grid-cards :global(.card-img) { height: 230px; }
  .grid-cards :global(.card-img--tall) { height: 340px; }

  .band--forest :global(.safe__img) { height: 460px; }
  @media (max-width: 860px) { .band--forest :global(.safe__img) { height: 300px; } }
  .checks { list-style: none; padding: 0; margin: 24px 0 34px; display: grid; gap: 10px 24px; grid-template-columns: repeat(2, minmax(0, 1fr)); font-weight: 600; color: #fff; }
  .checks li { display: flex; gap: 10px; align-items: center; }
  .checks :global(svg) { color: #F4A261; }

  .model { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .model__num { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--forest); color: #fff; font-family: var(--display); font-weight: 800; font-size: 22px; margin-bottom: 20px; }
  .model p { color: var(--body); font-size: 17px; margin: 8px 0 0; }
  @media (max-width: 860px) { .model { grid-template-columns: minmax(0, 1fr); } }

  .voice { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 48px; align-items: center; max-width: 1040px; }
  .voice :global(.voice__photo) { border-radius: 50%; }
  .voice figure { margin: 0; }
  .voice blockquote { margin: 0; font-family: var(--display); font-weight: 700; font-size: clamp(26px, 3vw, 36px); line-height: 1.25; color: var(--forest); letter-spacing: -0.015em; }
  .voice figcaption { margin-top: 20px; color: var(--body); }
  @media (max-width: 760px) { .voice { grid-template-columns: minmax(0, 1fr); } .voice :global(.voice__photo) { max-width: 180px; } }

  .tier { background: #fff; border: 1px solid var(--peach-line); border-radius: var(--radius); padding: 28px; position: relative; }
  .tier strong { font-family: var(--display); font-weight: 800; font-size: 38px; color: var(--forest); }
  .tier strong small { font-size: 18px; font-weight: 500; color: var(--muted); }
  .tier p { margin: 10px 0 0; font-size: 17px; color: var(--body); }
  .tier--featured { background: var(--forest); border-color: var(--forest); }
  .tier--featured strong { color: #fff; }
  .tier--featured strong small { color: var(--on-dark-muted); }
  .tier--featured p { color: var(--on-dark); }
  .tier__flag { position: absolute; top: -13px; left: 28px; background: var(--shirt); color: var(--ink); font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 999px; }
</style>

<script>
  // Home hero slideshow: cross-fades to the next photo every 6 seconds (paused when the tab is hidden).
  const hero = document.querySelector<HTMLElement>('.hero__slides');
  if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const slides = [...hero.querySelectorAll<HTMLElement>('.hero__slide')];
    let cur = 0;
    window.setInterval(() => {
      if (document.hidden) return;
      cur = (cur + 1) % slides.length;
      slides.forEach((sl, i) => { sl.dataset.active = String(i === cur); sl.setAttribute('aria-hidden', String(i !== cur)); });
    }, 6000);
  }
</script>
