---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { org } from '../data/site';
import { paypalGiftUrl } from '../lib/paypal';

const tiers = [
  { amount: 45, text: 'a month supports a girl’s return to school' },
  { amount: 50, text: 'a month provides essential care and counseling' },
  { amount: 100, text: 'a month funds livelihood and skills training for a mother' },
  { amount: 500, text: 'a year helps sustain a mother in the Safe Home' },
  { amount: 1000, label: '$1,000+', text: 'transforms multiple lives across our programs', wide: true },
];
const designations = [
  ['general', 'Where it’s needed most'],
  ['safe-home', 'Guadalupe Safe Home operations'],
  ['back-to-school', 'Back to School'],
  ['livelihoods', 'Livelihoods'],
  ['health', 'Maternal & child health'],
  ['solidarity-groups', 'Solidarity groups'],
  ['prevention', 'Prevention in schools'],
  ['summit', 'Your Worth Summit'],
];
const slides = [
  { name: 'who-1', alt: 'A young mother at a Smile Again gathering with her sleeping baby', pos: '50% 50%' },
  { name: 'proj-girlchild', alt: 'A young mother in Masaka holding her baby', pos: '40% 50%' },
  { name: 'body-1', alt: 'A young mother holding her baby at a health camp', pos: '50% 50%' },
];
const faqs = [
  ['Is my gift tax-deductible?', `For US donors, yes. Gifts are received by ${org.usEntity} in ${org.usCity}, a registered 501(c)(3) charity, EIN ${org.usEin}. Please keep your PayPal receipt for your records.`],
  ['How do I change or cancel a monthly gift?', 'Log in to PayPal and open Settings, then Payments, then Manage automatic payments. You can also email us and we will help.'],
  ['Can I give from Europe or elsewhere?', 'Yes. PayPal accepts cards and accounts from most countries and converts the currency for you. Tax relief outside the US depends on your country’s rules.'],
  ['Will I get a receipt?', 'PayPal emails you a receipt as soon as your gift is complete.'],
  ['Can I give to a specific program?', 'Yes. Choose a program in “Direct my gift to” and it is attached to your gift on PayPal, so we can direct it there.'],
  ['Can I give food, supplies or other goods?', 'Yes. We gratefully receive food, clothing, mama kits, baby clothes, diapers and sanitary pads. Contact us to arrange a gift of goods.'],
];
---
<Base
  title="Donate to Help Teenage Mothers in Uganda"
  description="Give monthly or once to Smile Again Families. Your gift funds counseling, school fees, skills training and the Guadalupe Safe Home for teenage mothers in Uganda. Tax-deductible in the US."
  image="who-1"
>
  <section class="give">
    <div class="wrap split split--top">
      <div class="give__intro">
        <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><span aria-current="page">Donate</span></li></ol></nav>
        <h1 class="h1 rise">Help a young mother smile again.</h1>
        <p class="lead rise rise-2" style="margin-top:22px">Your gift reaches mothers and children directly: food, childcare, school materials and counseling, and the staff who walk beside each woman as she rebuilds her life with dignity and hope.</p>
        <p class="rise rise-2 give__note">Every donation, big or small, plays a vital role in advancing the mission.</p>
        <div class="slides give__photo rise rise-3" role="region" aria-roledescription="carousel" aria-label="Mothers we serve">
          {slides.map((sl, i) => (
            <div class="slide" data-active={i === 0 ? 'true' : 'false'} aria-hidden={i === 0 ? 'false' : 'true'} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
              <Photo name={sl.name} alt={sl.alt} ratio="free" eager sizes="(max-width: 860px) 90vw, 600px" widths={[600, 900, 1200]} position={sl.pos} />
            </div>
          ))}
        </div>
      </div>

      <form class="give__form" id="give-form" aria-labelledby="give-title">
        <h2 class="h3" id="give-title">Make a gift</h2>
        <fieldset>
          <legend>How often?</legend>
          <div class="toggle">
            <button type="button" data-freq="monthly" aria-pressed="true">Monthly</button>
            <button type="button" data-freq="once" aria-pressed="false">One time</button>
          </div>
          <p class="small muted" style="margin-top:10px">Monthly gifts let us plan ahead for school terms and the Safe Home.</p>
        </fieldset>
        <fieldset>
          <legend>Amount (USD)</legend>
          <div class="amounts">
            {tiers.map((t, i) => (
              <button type="button" class:list={['amount', { 'amount--wide': t.wide }]} data-amount={t.amount} aria-pressed={i === 2 ? 'true' : 'false'}>
                <strong>{t.label ?? `$${t.amount}`}</strong><span>{t.text}</span>
              </button>
            ))}
          </div>
          <div class="field" style="margin-top:14px">
            <label for="other-amount">Other amount</label>
            <input class="input" id="other-amount" inputmode="decimal" placeholder="$" autocomplete="off" />
          </div>
        </fieldset>
        <div class="field">
          <label for="designation">Direct my gift to</label>
          <select class="select" id="designation">
            {designations.map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
        <button class="btn btn--give give__cta" type="submit" id="give-cta">Give $100 monthly</button>
        <p class="small muted" style="text-align:center;margin-top:12px">You’ll finish securely on PayPal with a card or PayPal account. Monthly gifts repeat automatically, and you can cancel any time.</p>
      </form>
    </div>
  </section>

  <section class="band band--sage">
    <div class="wrap split split--top">
      <div class="stack">
        <h2 class="h2">Give with confidence</h2>
        <ul class="ticks">
          <li><Icon name="check" /><span>Registered nonprofit in Masaka, Uganda since {org.registered}, led by a seven-member board</span></li>
          <li><Icon name="check" /><span>US gifts are tax-deductible through {org.usEntity}, a 501(c)(3) charity, EIN {org.usEin}</span></li>
          <li><Icon name="check" /><span>Ten years of work: 798 young mothers’ lives transformed</span></li>
        </ul>
        <p><a class="link-more" href="/about/team">Meet our leadership <Icon name="arrow" size={18} /></a></p>
      </div>
      <div class="stack">
        <h2 class="h2">Other ways to give</h2>
        <ul class="ways">
          <li><a href="/sponsor"><strong class="h4">Sponsor a young mother</strong><span>Cover one student’s tuition and follow her progress through school.</span></a></li>
          <li><a href="/our-work/safe-home"><strong class="h4">Support the Safe Home</strong><span>Help with food, medical care and childcare at the Guadalupe Mission Home.</span></a></li>
          <li><a href="/contact?type=partner"><strong class="h4">Partner with us</strong><span>Churches, schools and businesses can partner on programs or gifts of goods.</span></a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap wrap--narrow">
      <h2 class="h2" style="margin-bottom:32px">Questions about giving</h2>
      <div class="faq">
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <p class="muted" style="margin-top:28px">Other questions? Email <a href={`mailto:${org.email}`}>{org.email}</a>.</p>
    </div>
  </section>
</Base>

<style>
  .give { background: var(--sage); padding-block: clamp(40px, 6vw, 80px) var(--space); }
  .give__intro :global(.give__photo) { width: 100%; margin-top: 40px; }
  .slides { position: relative; height: 475px; border-radius: var(--arch); overflow: hidden; background: var(--sage-2); }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity .9s ease; }
  .slide[data-active="true"] { opacity: 1; }
  .slide :global(.ph) { height: 100%; border-radius: 0; }
  @media (prefers-reduced-motion: reduce) { .slide { transition-duration: .3s; } }
  @media (max-width: 860px) { .give__intro :global(.give__photo) { display: none; } }
  .give__form { background: #fff; border-radius: 22px; padding: clamp(24px, 4vw, 44px); box-shadow: 0 24px 60px rgba(16,36,26,.10); display: grid; gap: 26px; }
  .give__form fieldset { border: 0; margin: 0; padding: 0; }
  .give__form legend { font-weight: 700; font-size: 17px; margin-bottom: 12px; }
  .toggle { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; background: var(--sage); padding: 6px; border-radius: 999px; }
  .toggle button { min-height: 48px; border: 0; border-radius: 999px; font: inherit; font-weight: 700; font-size: 17px; cursor: pointer; background: transparent; color: var(--forest); }
  .toggle button[aria-pressed="true"] { background: var(--forest); color: #fff; }
  .amounts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .amount { display: grid; gap: 4px; text-align: left; padding: 14px 16px; border-radius: 14px; border: 1.5px solid #C6D2CA; background: #fff; font: inherit; color: var(--ink); cursor: pointer; min-height: 96px; align-content: start; }
  .amount--wide { grid-column: 1 / -1; min-height: 0; }
  .give__note { margin-top: 16px; font-family: var(--display); font-weight: 700; font-size: 19px; color: var(--forest); }
  .amount strong { font-family: var(--serif); font-size: 28px; line-height: 1; }
  .amount span { font-size: 15px; color: var(--body); line-height: 1.35; }
  .amount[aria-pressed="true"] { border: 2px solid var(--forest); background: var(--sage); }
  .amount:hover { border-color: var(--forest); }
  @media (max-width: 420px) { .amounts { grid-template-columns: minmax(0, 1fr); } }
  .give__cta { width: 100%; min-height: 62px; font-size: 20px; }
  .ways { list-style: none; margin: 0; padding: 0; }
  .ways li { border-bottom: 1px solid var(--line); }
  .ways a { display: grid; gap: 4px; padding: 20px 0; text-decoration: none; color: var(--ink); }
  .ways span { color: var(--body); font-size: 17px; }
  .ways a:hover strong { color: var(--leaf); text-decoration: underline; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 20px 0; font-family: var(--serif); font-size: 22px; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 20px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; font-family: var(--sans); color: var(--leaf); font-size: 26px; line-height: 1; }
  .faq details[open] summary::after { content: "–"; }
  .faq details p { color: var(--body); padding-bottom: 22px; max-width: 40em; }
</style>

<script>
  // Photo slideshow beside the donation form: cross-fades to the next photo every 5 seconds.
  const show = document.querySelector<HTMLElement>('.slides');
  if (show) {
    const slides = [...show.querySelectorAll<HTMLElement>('.slide')];
    let cur = 0;
    const go = (n: number) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((sl, i) => { sl.dataset.active = String(i === cur); sl.setAttribute('aria-hidden', String(i !== cur)); });
    };
    window.setInterval(() => { if (!document.hidden) go(cur + 1); }, 5000);
  }

  import { paypalGiftUrl } from '../lib/paypal';
  const form = document.getElementById('give-form') as HTMLFormElement;
  const cta = document.getElementById('give-cta')!;
  const other = document.getElementById('other-amount') as HTMLInputElement;
  const select = document.getElementById('designation') as HTMLSelectElement;
  let freq = 'monthly';
  let amount = '100';

  const want = new URLSearchParams(location.search).get('for');
  if (want && [...select.options].some((o) => o.value === want)) select.value = want;

  function render() {
    const custom = other.value.replace(/[^0-9.]/g, '');
    const shown = custom || amount;
    const pretty = Number(shown) ? Number(shown).toLocaleString('en-US', { maximumFractionDigits: 2 }) : shown;
    cta.textContent = `Give $${pretty}${freq === 'monthly' ? ' monthly' : ''}`;
  }
  form.querySelectorAll<HTMLButtonElement>('[data-freq]').forEach((b) =>
    b.addEventListener('click', () => {
      freq = b.dataset.freq!;
      form.querySelectorAll('[data-freq]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }),
  );
  form.querySelectorAll<HTMLButtonElement>('.amount').forEach((b) =>
    b.addEventListener('click', () => {
      amount = b.dataset.amount!;
      other.value = '';
      form.querySelectorAll('.amount').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }),
  );
  other.addEventListener('input', () => {
    if (other.value) form.querySelectorAll('.amount').forEach((x) => x.setAttribute('aria-pressed', 'false'));
    render();
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const custom = other.value.replace(/[^0-9.]/g, '');
    const purpose = select.options[select.selectedIndex].text;
    window.location.href = paypalGiftUrl({ amount: custom || amount, monthly: freq === 'monthly', purpose });
  });
</script>
