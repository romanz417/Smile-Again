# Copy to .env and fill in from Supabase → Project Settings → API.
# The publishable (anon) key is safe in the browser; row-level security limits it
# to inserting form submissions and reading published stories.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# PayPal hosted donate button (from the current site)
PUBLIC_PAYPAL_DONATE_URL=https://www.paypal.com/donate/?hosted_button_id=MZX6WAF96MQ4U
